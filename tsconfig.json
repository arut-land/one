{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "bindings/typescript/src",
    "runtimes/browser",
    "surfaces/chat-ui/src",
    "surfaces/web/src",
    "surfaces/chromium/src",
    "surfaces/vscode/src/webview.tsx"
  ]
}
