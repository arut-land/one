<UserControl
  x:Class="Arut.Surface.Windows.MessageBubble"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:toolkit="using:CommunityToolkit.WinUI"
>
  <Grid x:Name="Root" Padding="0,0,0,2">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Incoming" />
        <VisualState x:Name="Outgoing">
          <VisualState.Setters>
            <Setter
              Target="BubbleBackground.Background"
              Value="{ThemeResource AccentFillColorDefaultBrush}"
            />
            <Setter
              Target="MessageText.Foreground"
              Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
            />
            <Setter
              Target="TimeText.Foreground"
              Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
            />
            <Setter Target="BubbleBackground.CornerRadius" Value="16,16,4,16" />
            <Setter Target="Bubble.HorizontalAlignment" Value="Right" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      x:Name="TimeGroup"
      toolkit:TransitionHelper.IsIndependent="True"
      HorizontalAlignment="Center"
      Margin="0,20,0,14"
      FontSize="12"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
    <Grid x:Name="Bubble" Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left">
      <Grid.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem x:Name="CopyItem" Click="Copy">
            <MenuFlyoutItem.Icon>
              <SymbolIcon Symbol="Copy" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
        </MenuFlyout>
      </Grid.ContextFlyout>
      <Border
        x:Name="BubbleBackground"
        toolkit:TransitionHelper.Id="background"
        CornerRadius="16,16,16,4"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
      />
      <Grid RowSpacing="4" Margin="15,11,15,9">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
          x:Name="MessageText"
          toolkit:TransitionHelper.Id="text"
          HorizontalAlignment="Left"
          FontSize="14"
          LineHeight="21"
          TextWrapping="Wrap"
          IsTextSelectionEnabled="True"
        />
        <TextBlock
          x:Name="TimeText"
          toolkit:TransitionHelper.IsIndependent="True"
          Grid.Row="1"
          HorizontalAlignment="Right"
          FontSize="11"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
