<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ResourceDictionary.ThemeDictionaries>
    <!-- Layer brushes carry light and dark; High Contrast needs the system
         colors, or the incoming bubble loses its boundary entirely. -->
    <ResourceDictionary x:Key="Default">
      <Thickness x:Key="ToolbarBorderThickness">0</Thickness>
      <StaticResource
        x:Key="IncomingBubbleBackgroundBrush"
        ResourceKey="CardBackgroundFillColorDefaultBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleBorderBrush"
        ResourceKey="CardStrokeColorDefaultBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleForegroundBrush"
        ResourceKey="TextFillColorPrimaryBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleCaptionBrush"
        ResourceKey="TextFillColorSecondaryBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleBackgroundBrush"
        ResourceKey="AccentFillColorDefaultBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleBorderBrush"
        ResourceKey="AccentFillColorDefaultBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleForegroundBrush"
        ResourceKey="TextOnAccentFillColorPrimaryBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleCaptionBrush"
        ResourceKey="TextOnAccentFillColorSecondaryBrush"
      />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <Thickness x:Key="ToolbarBorderThickness">1</Thickness>
      <StaticResource
        x:Key="IncomingBubbleBackgroundBrush"
        ResourceKey="SystemColorWindowColorBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleBorderBrush"
        ResourceKey="SystemColorWindowTextColorBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleForegroundBrush"
        ResourceKey="SystemColorWindowTextColorBrush"
      />
      <StaticResource
        x:Key="IncomingBubbleCaptionBrush"
        ResourceKey="SystemColorWindowTextColorBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleBackgroundBrush"
        ResourceKey="SystemColorHighlightColorBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleBorderBrush"
        ResourceKey="SystemColorHighlightTextColorBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleForegroundBrush"
        ResourceKey="SystemColorHighlightTextColorBrush"
      />
      <StaticResource
        x:Key="OutgoingBubbleCaptionBrush"
        ResourceKey="SystemColorHighlightTextColorBrush"
      />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style
    x:Key="IconButtonStyle"
    TargetType="Button"
    BasedOn="{StaticResource DefaultButtonStyle}"
  >
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{ThemeResource ToolbarBorderThickness}" />
  </Style>
  <Style
    x:Key="TimeGroupStyle"
    TargetType="TextBlock"
    BasedOn="{StaticResource CaptionTextBlockStyle}"
  >
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,24,0,16" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="BubbleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>
  <Style
    x:Key="BubbleTimeStyle"
    TargetType="TextBlock"
    BasedOn="{StaticResource CaptionTextBlockStyle}"
  >
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style x:Key="BubbleStyle" TargetType="Border">
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
</ResourceDictionary>
