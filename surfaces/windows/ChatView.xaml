<UserControl
  x:Class="Arut.Surface.Windows.ChatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Arut.Surface.Windows"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <x:Double x:Key="ScrollFadeOpacity">1</x:Double>
          <x:Double x:Key="BottomScrollFadeOpacity">0.5</x:Double>
          <Thickness x:Key="ToolbarBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <x:Double x:Key="ScrollFadeOpacity">0</x:Double>
          <x:Double x:Key="BottomScrollFadeOpacity">0</x:Double>
          <Thickness x:Key="ToolbarBorderThickness">1</Thickness>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StandardUICommand x:Key="CopyMessageCommand" Kind="Copy" ExecuteRequested="CopyMessage" />
      <MenuFlyout x:Name="MessageMenu">
        <MenuFlyoutItem Command="{StaticResource CopyMessageCommand}" />
      </MenuFlyout>
      <XamlUICommand x:Key="NewChatCommand" ExecuteRequested="NewChat">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="N" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <XamlUICommand x:Key="SearchCommand" ExecuteRequested="FocusSearch">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="F" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <Style
        x:Key="IconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}"
      >
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{ThemeResource ToolbarBorderThickness}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleHistoryShortcut" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusComposerShortcut" />
    </Grid.KeyboardAccelerators>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="CompactTitle">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ConversationTitle.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="FullTitle">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="400" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ComposerFocusStates">
        <VisualState x:Name="ComposerUnfocused" />
        <VisualState x:Name="ComposerFocused">
          <VisualState.Setters>
            <Setter
              Target="ComposerCard.BorderBrush"
              Value="{ThemeResource TextControlBorderBrushFocused}"
            />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Overlay" />
            <Setter Target="Shell.IsPaneOpen" Value="False" />
            <Setter Target="ConversationPanel.Margin" Value="4,0,4,4" />
            <Setter Target="ComposerArea.Padding" Value="12,8,12,12" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="800" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Inline" />
            <Setter Target="Shell.IsPaneOpen" Value="True" />
            <Setter Target="Shell.PaneBackground" Value="Transparent" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <local:DesktopTitleBar
      x:Name="AppTitleBar"
      Title="{x:Bind AppName}"
      IsPaneToggleButtonVisible="True"
      PaneToggleRequested="TitleBarToggle"
    >
      <TitleBar.IconSource>
        <BitmapIconSource UriSource="ms-appx:///Assets/Arut.png" ShowAsMonochrome="False" />
      </TitleBar.IconSource>
      <TitleBar.Resources>
        <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
        <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
        <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">
          Stretch
        </HorizontalAlignment>
      </TitleBar.Resources>
      <TitleBar.Content>
        <TextBlock
          x:Name="ConversationTitle"
          Style="{ThemeResource CaptionTextBlockStyle}"
          IsHitTestVisible="False"
          TextWrapping="NoWrap"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          Margin="0,0,12,0"
        />
      </TitleBar.Content>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button
            x:Name="SearchButton"
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource SearchCommand}"
            AutomationProperties.Name="{x:Bind SearchLabel}"
            ToolTipService.ToolTip="{x:Bind SearchLabel}"
          >
            <FontIcon Glyph="&#xE721;" FontSize="16" />
          </Button>
          <Button
            x:Name="NewChatButton"
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource NewChatCommand}"
            AutomationProperties.Name="{x:Bind NewConversationLabel}"
            ToolTipService.ToolTip="{x:Bind NewConversationTooltip}"
          >
            <FontIcon Glyph="&#xE710;" FontSize="16" />
          </Button>
        </StackPanel>
      </TitleBar.RightHeader>
    </local:DesktopTitleBar>
    <SplitView
      x:Name="Shell"
      Grid.Row="1"
      OpenPaneLength="280"
      DisplayMode="Overlay"
      PaneBackground="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
    >
      <SplitView.Pane>
        <Grid Padding="12,16,12,12" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="{x:Bind HistoryLabel}"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Margin="12,0"
          />
          <AutoSuggestBox
            x:Name="Search"
            Grid.Row="1"
            PlaceholderText="{x:Bind SearchLabel}"
            QueryIcon="Find"
            TextChanged="SearchChanged"
            AutomationProperties.Name="{x:Bind SearchLabel}"
          />
          <Grid Grid.Row="2">
            <ListView
              x:Name="History"
              ItemsSource="{x:Bind Summaries}"
              SelectionChanged="SelectChat"
              IsItemClickEnabled="True"
              ItemClick="ActivateChat"
              AutomationProperties.Name="{x:Bind HistoryLabel}"
            >
              <ListView.ItemContainerTransitions>
                <TransitionCollection />
              </ListView.ItemContainerTransitions>
              <ListView.ItemContainerStyle>
                <Style
                  TargetType="ListViewItem"
                  BasedOn="{StaticResource DefaultListViewItemStyle}"
                >
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="12,8" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConversationRow">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Width="32"
                      Height="32"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      VerticalAlignment="Center"
                    >
                      <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                      />
                      <TextBlock
                        Text="{x:Bind Preview, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
              x:Name="HistoryEmpty"
              Text="{x:Bind HistoryEmptyLabel}"
              TextWrapping="Wrap"
              Margin="12,16"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              IsHitTestVisible="False"
            />
          </Grid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="12,4">
            <FontIcon
              Glyph="&#xE770;"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
            <TextBlock
              Text="{x:Bind SessionLabel}"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
        </Grid>
      </SplitView.Pane>
      <Border
        x:Name="ConversationPanel"
        Margin="4,0,8,8"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
      >
        <Grid>
          <Grid x:Name="TranscriptArea">
            <ListView
              x:Name="Transcript"
              ItemsSource="{Binding Messages}"
              SelectionMode="None"
              Padding="16,0,16,0"
              Loaded="TranscriptLoaded"
              SizeChanged="TranscriptSizeChanged"
              AutomationProperties.Name="{x:Bind TranscriptLabel}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            >
              <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
              </ListView.Resources>
              <ListView.Footer>
                <Border
                  x:Name="TranscriptEndSpace"
                  IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw"
                />
              </ListView.Footer>
              <ListView.ItemContainerTransitions>
                <TransitionCollection />
              </ListView.ItemContainerTransitions>
              <ListView.ItemContainerStyle>
                <Style
                  TargetType="ListViewItem"
                  BasedOn="{StaticResource DefaultListViewItemStyle}"
                >
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="ContextFlyout" Value="{StaticResource MessageMenu}" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MessageRow">
                  <local:MessageBubble
                    Message="{x:Bind}"
                    MaxWidth="880"
                    HorizontalAlignment="Stretch"
                  />
                </DataTemplate>
              </ListView.ItemTemplate>
              <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
              </ListView.ItemsPanel>
            </ListView>
            <Rectangle
              x:Name="TopScrollFade"
              Opacity="{ThemeResource ScrollFadeOpacity}"
              Height="24"
              Margin="16,0,16,0"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              AutomationProperties.AccessibilityView="Raw"
            >
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop
                    x:Name="TopFadeColor"
                    Color="{ThemeResource SolidBackgroundFillColorBase}"
                  />
                  <GradientStop
                    Color="{x:Bind TransparentColor(TopFadeColor.Color), Mode=OneWay}"
                    Offset="1"
                  />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle
              x:Name="BottomScrollFade"
              Opacity="{ThemeResource BottomScrollFadeOpacity}"
              Margin="16,0,16,0"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              AutomationProperties.AccessibilityView="Raw"
            >
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{x:Bind TransparentColor(BottomFadeColor.Color), Mode=OneWay}" />
                  <GradientStop
                    x:Name="BottomFadeColor"
                    Color="{ThemeResource SolidBackgroundFillColorBase}"
                    Offset="0.5"
                  />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <StackPanel
              x:Name="EmptyState"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="12"
              MaxWidth="360"
              Margin="24"
              IsHitTestVisible="False"
            >
              <Border
                Width="64"
                Height="64"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Margin="0,0,0,8"
              >
                <FontIcon
                  Glyph="&#xE8F2;"
                  FontSize="28"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                />
              </Border>
              <TextBlock
                Text="{x:Bind EmptyTitle}"
                Style="{ThemeResource TitleTextBlockStyle}"
                TextWrapping="Wrap"
                TextAlignment="Center"
              />
              <TextBlock
                Text="{x:Bind EmptyHint}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
            </StackPanel>
            <Grid
              x:Name="LatestArea"
              MaxWidth="880"
              Margin="24,0,24,8"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
            >
              <Border
                x:Name="LatestSurface"
                Width="36"
                Height="36"
                CornerRadius="18"
                Translation="0,0,12"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              >
                <Border.Shadow>
                  <ThemeShadow />
                </Border.Shadow>
                <Button
                  x:Name="LatestButton"
                  Background="Transparent"
                  Width="36"
                  Height="36"
                  Padding="0"
                  CornerRadius="18"
                  Click="ScrollToLatest"
                  ToolTipService.ToolTip="{x:Bind LatestLabel}"
                  AutomationProperties.Name="{x:Bind LatestLabel}"
                >
                  <FontIcon Glyph="&#xE74B;" FontSize="14" />
                </Button>
              </Border>
            </Grid>
          </Grid>
          <Grid
            x:Name="ComposerArea"
            VerticalAlignment="Bottom"
            Padding="24,8,24,20"
            SizeChanged="ComposerAreaSizeChanged"
          >
            <Grid MaxWidth="880" HorizontalAlignment="Stretch" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <InfoBar
                IsOpen="{Binding HasError}"
                Severity="Error"
                IsClosable="False"
                Message="{Binding Error}"
              />
              <Grid
                Grid.Row="1"
                x:Name="ComposerCard"
                BorderThickness="1"
                BorderBrush="{ThemeResource TextControlBorderBrush}"
                Padding="8"
                CornerRadius="27"
                Translation="0,0,16"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              >
                <Grid.Shadow>
                  <ThemeShadow />
                </Grid.Shadow>
                <TextBox
                  x:Name="Composer"
                  Margin="0,0,40,0"
                  Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="{x:Bind ComposerLabel}"
                  AutomationProperties.Name="{x:Bind ComposerLabel}"
                  AutomationProperties.HelpText="{x:Bind ComposerHint}"
                  ToolTipService.ToolTip="{x:Bind ComposerHint}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  MinHeight="36"
                  VerticalAlignment="Bottom"
                  MaxHeight="164"
                  FontSize="14"
                  Padding="10,7"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewKeyDown="ComposerKeyDown"
                  UseSystemFocusVisuals="False"
                  GotFocus="ComposerFocusChanged"
                  LostFocus="ComposerFocusChanged"
                >
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                  </TextBox.Resources>
                  <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="SendShortcut" />
                  </TextBox.KeyboardAccelerators>
                </TextBox>
                <Button
                  x:Name="SendButton"
                  HorizontalAlignment="Right"
                  Width="36"
                  Height="36"
                  Padding="0"
                  CornerRadius="18"
                  VerticalAlignment="Bottom"
                  Style="{ThemeResource AccentButtonStyle}"
                  IsEnabled="{Binding CanSend}"
                  Click="Send"
                  AutomationProperties.Name="{x:Bind SendLabel}"
                  ToolTipService.ToolTip="{x:Bind SendLabel}"
                >
                  <Grid>
                    <FontIcon x:Name="SendGlyph" Glyph="&#xE724;" FontSize="16" />
                    <ProgressRing
                      x:Name="SendingRing"
                      Width="16"
                      Height="16"
                      IsActive="False"
                      Visibility="Collapsed"
                    />
                  </Grid>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </SplitView>
    <Canvas
      x:Name="SendLayer"
      Grid.RowSpan="2"
      IsHitTestVisible="False"
      AutomationProperties.AccessibilityView="Raw"
    />
  </Grid>
</UserControl>
