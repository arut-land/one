<UserControl
  x:Class="Arut.Surface.Windows.ChatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Arut.Surface.Windows"
  xmlns:ffi="using:Arut.Ffi"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Layer brushes carry light and dark; High Contrast needs the system
             colors, or the incoming bubble loses its boundary entirely. -->
        <ResourceDictionary x:Key="Default">
          <Thickness x:Key="ToolbarBorderThickness">0</Thickness>
          <StaticResource
            x:Key="IncomingBubbleBackgroundBrush"
            ResourceKey="CardBackgroundFillColorDefaultBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleBorderBrush"
            ResourceKey="CardStrokeColorDefaultBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleForegroundBrush"
            ResourceKey="TextFillColorPrimaryBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleCaptionBrush"
            ResourceKey="TextFillColorSecondaryBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleBackgroundBrush"
            ResourceKey="AccentFillColorDefaultBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleBorderBrush"
            ResourceKey="AccentFillColorDefaultBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleForegroundBrush"
            ResourceKey="TextOnAccentFillColorPrimaryBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleCaptionBrush"
            ResourceKey="TextOnAccentFillColorSecondaryBrush"
          />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <Thickness x:Key="ToolbarBorderThickness">1</Thickness>
          <StaticResource
            x:Key="IncomingBubbleBackgroundBrush"
            ResourceKey="SystemColorWindowColorBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleBorderBrush"
            ResourceKey="SystemColorWindowTextColorBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleForegroundBrush"
            ResourceKey="SystemColorWindowTextColorBrush"
          />
          <StaticResource
            x:Key="IncomingBubbleCaptionBrush"
            ResourceKey="SystemColorWindowTextColorBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleBackgroundBrush"
            ResourceKey="SystemColorHighlightColorBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleBorderBrush"
            ResourceKey="SystemColorHighlightTextColorBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleForegroundBrush"
            ResourceKey="SystemColorHighlightTextColorBrush"
          />
          <StaticResource
            x:Key="OutgoingBubbleCaptionBrush"
            ResourceKey="SystemColorHighlightTextColorBrush"
          />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StandardUICommand x:Key="CopyMessageCommand" Kind="Copy" ExecuteRequested="CopyMessage" />
      <XamlUICommand x:Key="NewChatCommand" ExecuteRequested="NewChat">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="N" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <XamlUICommand x:Key="SearchCommand" ExecuteRequested="FocusSearch">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="F" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <Style
        x:Key="IconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}"
      >
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{ThemeResource ToolbarBorderThickness}" />
      </Style>
      <Style
        x:Key="TimeGroupStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
      >
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,24,0,16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="BubbleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
      </Style>
      <Style
        x:Key="BubbleTimeStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
      >
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>
      <Style x:Key="BubbleStyle" TargetType="Border">
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="Padding" Value="16,12" />
      </Style>
      <DataTemplate x:Key="IncomingMessage" x:DataType="local:MessageRow">
        <Grid Margin="{x:Bind Spacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="{x:Bind TimeGroup}"
            Visibility="{x:Bind HasTimeGroup}"
            Style="{StaticResource TimeGroupStyle}"
          />
          <Border
            Grid.Row="1"
            Style="{StaticResource BubbleStyle}"
            Margin="0,0,48,0"
            HorizontalAlignment="Left"
            CornerRadius="16,16,16,4"
            Background="{ThemeResource IncomingBubbleBackgroundBrush}"
            BorderBrush="{ThemeResource IncomingBubbleBorderBrush}"
            BorderThickness="1"
            Foreground="{ThemeResource IncomingBubbleForegroundBrush}"
            ToolTipService.ToolTip="{x:Bind FullTime}"
          >
            <Border.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem
                  Command="{StaticResource CopyMessageCommand}"
                  CommandParameter="{x:Bind Text}"
                />
              </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel>
              <TextBlock Text="{x:Bind Text}" Style="{StaticResource BubbleTextStyle}" />
              <TextBlock
                Text="{x:Bind Time}"
                Visibility="{x:Bind HasTime}"
                Style="{StaticResource BubbleTimeStyle}"
                Foreground="{ThemeResource IncomingBubbleCaptionBrush}"
              />
            </StackPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="OutgoingMessage" x:DataType="local:MessageRow">
        <Grid Margin="{x:Bind Spacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="{x:Bind TimeGroup}"
            Visibility="{x:Bind HasTimeGroup}"
            Style="{StaticResource TimeGroupStyle}"
          />
          <Border
            Grid.Row="1"
            Style="{StaticResource BubbleStyle}"
            Margin="48,0,0,0"
            HorizontalAlignment="Right"
            CornerRadius="16,16,4,16"
            Background="{ThemeResource OutgoingBubbleBackgroundBrush}"
            BorderBrush="{ThemeResource OutgoingBubbleBorderBrush}"
            BorderThickness="1"
            ToolTipService.ToolTip="{x:Bind FullTime}"
          >
            <Border.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem
                  Command="{StaticResource CopyMessageCommand}"
                  CommandParameter="{x:Bind Text}"
                />
              </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel>
              <TextBlock
                Text="{x:Bind Text}"
                Style="{StaticResource BubbleTextStyle}"
                Foreground="{ThemeResource OutgoingBubbleForegroundBrush}"
              />
              <TextBlock
                Text="{x:Bind Time}"
                Visibility="{x:Bind HasTime}"
                Style="{StaticResource BubbleTimeStyle}"
                Foreground="{ThemeResource OutgoingBubbleCaptionBrush}"
              />
            </StackPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <local:MessageTemplateSelector
        x:Key="MessageTemplate"
        Incoming="{StaticResource IncomingMessage}"
        Outgoing="{StaticResource OutgoingMessage}"
      />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleHistoryShortcut" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusComposerShortcut" />
    </Grid.KeyboardAccelerators>
    <VisualStateManager.VisualStateGroups>
      <!-- The unnamed first state is the narrow one; a trigger belongs on the
           wide side only, since `MinWindowWidth="0"` is the implicit default. -->
      <VisualStateGroup>
        <VisualState x:Name="CompactTitle" />
        <VisualState x:Name="FullTitle">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="400" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ConversationTitle.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ComposerFocusStates">
        <VisualState x:Name="ComposerUnfocused" />
        <VisualState x:Name="ComposerFocused">
          <VisualState.Setters>
            <Setter
              Target="ComposerCard.BorderBrush"
              Value="{ThemeResource TextControlBorderBrushFocused}"
            />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Overlay" />
            <Setter Target="Shell.IsPaneOpen" Value="False" />
            <Setter Target="ConversationPanel.Margin" Value="4,0,4,4" />
            <Setter Target="ComposerArea.Padding" Value="12,8,12,12" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="800" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Inline" />
            <Setter Target="Shell.IsPaneOpen" Value="True" />
            <Setter Target="Shell.PaneBackground" Value="Transparent" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <local:DesktopTitleBar
      x:Name="AppTitleBar"
      Title="{x:Bind local:Labels.AppName}"
      IsPaneToggleButtonVisible="True"
      PaneToggleRequested="TitleBarToggle"
    >
      <TitleBar.IconSource>
        <BitmapIconSource UriSource="ms-appx:///Assets/Arut.png" ShowAsMonochrome="False" />
      </TitleBar.IconSource>
      <TitleBar.Resources>
        <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
        <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
        <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">
          Stretch
        </HorizontalAlignment>
      </TitleBar.Resources>
      <TitleBar.Content>
        <TextBlock
          x:Name="ConversationTitle"
          Visibility="Collapsed"
          Text="{x:Bind ViewModel.Title, Mode=OneWay}"
          Style="{StaticResource CaptionTextBlockStyle}"
          IsHitTestVisible="False"
          TextWrapping="NoWrap"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          Margin="0,0,12,0"
        />
      </TitleBar.Content>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource SearchCommand}"
            AutomationProperties.Name="{x:Bind local:Labels.Search}"
            ToolTipService.ToolTip="{x:Bind local:Labels.Search}"
          >
            <FontIcon Glyph="&#xE721;" FontSize="16" />
          </Button>
          <Button
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource NewChatCommand}"
            AutomationProperties.Name="{x:Bind local:Labels.NewConversation}"
            ToolTipService.ToolTip="{x:Bind local:Labels.NewConversationShortcut}"
          >
            <FontIcon Glyph="&#xE710;" FontSize="16" />
          </Button>
        </StackPanel>
      </TitleBar.RightHeader>
    </local:DesktopTitleBar>
    <SplitView
      x:Name="Shell"
      Grid.Row="1"
      OpenPaneLength="280"
      DisplayMode="Overlay"
      PaneBackground="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
    >
      <SplitView.Pane>
        <Grid Padding="12,16,12,12" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            x:Uid="label_conversations"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Margin="12,0"
          />
          <AutoSuggestBox
            x:Name="Search"
            Grid.Row="1"
            Header="{x:Bind local:Labels.Search}"
            Text="{x:Bind ViewModel.Search, Mode=TwoWay}"
            PlaceholderText="{x:Bind local:Labels.Search}"
            QueryIcon="Find"
            AutomationProperties.Name="{x:Bind local:Labels.Search}"
          />
          <Grid Grid.Row="2">
            <ListView
              x:Name="History"
              AutomationProperties.Name="{x:Bind local:Labels.Conversations}"
              ItemsSource="{x:Bind ViewModel.Conversations}"
              SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
              SelectionChanged="ChatSelected"
            >
              <ListView.ItemContainerTransitions>
                <TransitionCollection />
              </ListView.ItemContainerTransitions>
              <ListView.ItemContainerStyle>
                <Style
                  TargetType="ListViewItem"
                  BasedOn="{StaticResource DefaultListViewItemStyle}"
                >
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="12,8" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="ffi:ChatSummary">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Width="32"
                      Height="32"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      VerticalAlignment="Center"
                    >
                      <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Text="{x:Bind Title}"
                          FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis"
                        />
                        <!-- Rust decides what is unread; the dot only draws it. -->
                        <Ellipse
                          Grid.Column="1"
                          Width="8"
                          Height="8"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind Unread}"
                          Fill="{ThemeResource AccentFillColorDefaultBrush}"
                          AutomationProperties.Name="{x:Bind local:Labels.Unread}"
                        />
                      </Grid>
                      <TextBlock
                        Text="{x:Bind Preview}"
                        TextWrapping="NoWrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
              Text="{x:Bind ViewModel.HistoryEmptyLabel, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.IsHistoryEmpty, Mode=OneWay}"
              TextWrapping="Wrap"
              Margin="12,16"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              IsHitTestVisible="False"
            />
          </Grid>
        </Grid>
      </SplitView.Pane>
      <Border
        x:Name="ConversationPanel"
        Margin="4,0,8,8"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
      >
        <Grid>
          <ListView
            x:Name="Transcript"
            x:Uid="label_transcript"
            ItemsSource="{x:Bind ViewModel.Conversation.Messages, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource MessageTemplate}"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            SingleSelectionFollowsFocus="False"
            Padding="16,0,16,0"
            Loaded="TranscriptLoaded"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          >
            <ListView.KeyboardAccelerators>
              <!-- The copy command's keyboard route: the focused row, copied. -->
              <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopySelectedMessage" />
            </ListView.KeyboardAccelerators>
            <ListView.Footer>
              <Border
                x:Name="TranscriptEndSpace"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw"
              />
            </ListView.Footer>
            <ListView.ItemContainerTransitions>
              <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="True" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
          <StackPanel
            x:Name="EmptyState"
            Visibility="{x:Bind ViewModel.Conversation.IsEmpty, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="360"
            Margin="24"
            IsHitTestVisible="False"
          >
            <Border
              Width="64"
              Height="64"
              CornerRadius="{ThemeResource OverlayCornerRadius}"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Margin="0,0,0,8"
            >
              <FontIcon
                Glyph="&#xE8F2;"
                FontSize="28"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
              />
            </Border>
            <TextBlock
              Text="{x:Bind local:Labels.EmptyTitle}"
              Style="{StaticResource TitleTextBlockStyle}"
              TextWrapping="Wrap"
              TextAlignment="Center"
            />
            <TextBlock
              Text="{x:Bind local:Labels.EmptyHint}"
              TextWrapping="Wrap"
              TextAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
          <Grid
            x:Name="LatestArea"
            MaxWidth="880"
            Margin="24,0,24,8"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
          >
            <Border
              x:Name="LatestSurface"
              Width="36"
              Height="36"
              CornerRadius="18"
              Translation="0,0,12"
              HorizontalAlignment="Right"
              Visibility="Collapsed"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            >
              <Border.Shadow>
                <ThemeShadow />
              </Border.Shadow>
              <Button
                Background="Transparent"
                Width="36"
                Height="36"
                Padding="0"
                CornerRadius="18"
                Click="ScrollToLatest"
                ToolTipService.ToolTip="{x:Bind local:Labels.Latest}"
                AutomationProperties.Name="{x:Bind local:Labels.Latest}"
              >
                <FontIcon Glyph="&#xE74B;" FontSize="14" />
              </Button>
            </Border>
          </Grid>
          <Grid
            x:Name="ComposerArea"
            VerticalAlignment="Bottom"
            Padding="24,8,24,20"
            SizeChanged="ComposerAreaSizeChanged"
          >
            <Grid MaxWidth="880" HorizontalAlignment="Stretch" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <InfoBar
                IsOpen="{x:Bind ViewModel.Conversation.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Conversation.Error, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
              />
              <Grid
                Grid.Row="1"
                x:Name="ComposerCard"
                BorderThickness="1"
                BorderBrush="{ThemeResource TextControlBorderBrush}"
                Padding="8"
                CornerRadius="27"
                Translation="0,0,16"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              >
                <Grid.Shadow>
                  <ThemeShadow />
                </Grid.Shadow>
                <TextBox
                  x:Name="Composer"
                  Margin="0,0,40,0"
                  Text="{x:Bind ViewModel.Conversation.Draft.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="{x:Bind local:Labels.Composer}"
                  AutomationProperties.Name="{x:Bind local:Labels.Composer}"
                  AutomationProperties.HelpText="{x:Bind local:Labels.ComposerHint}"
                  ToolTipService.ToolTip="{x:Bind local:Labels.ComposerHint}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  MinHeight="36"
                  VerticalAlignment="Bottom"
                  MaxHeight="164"
                  FontSize="14"
                  Padding="10,7"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewKeyDown="ComposerKeyDown"
                  UseSystemFocusVisuals="False"
                  GotFocus="ComposerFocusChanged"
                  LostFocus="ComposerFocusChanged"
                >
                  <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="SendShortcut" />
                  </TextBox.KeyboardAccelerators>
                </TextBox>
                <Button
                  x:Name="SendButton"
                  HorizontalAlignment="Right"
                  Width="36"
                  Height="36"
                  Padding="0"
                  CornerRadius="18"
                  VerticalAlignment="Bottom"
                  Style="{StaticResource AccentButtonStyle}"
                  Command="{x:Bind ViewModel.Conversation.SendCommand, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind local:Labels.Send}"
                  ToolTipService.ToolTip="{x:Bind local:Labels.Send}"
                >
                  <Grid>
                    <FontIcon
                      Glyph="&#xE724;"
                      FontSize="16"
                      Visibility="{x:Bind ViewModel.Conversation.IsIdle, Mode=OneWay}"
                    />
                    <ProgressRing
                      Width="16"
                      Height="16"
                      IsActive="{x:Bind ViewModel.Conversation.IsSending, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Conversation.IsSending, Mode=OneWay}"
                    />
                  </Grid>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </SplitView>
  </Grid>
</UserControl>
