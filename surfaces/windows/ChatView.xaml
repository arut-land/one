<UserControl
  x:Class="Arut.Surface.Windows.ChatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Arut.Surface.Windows"
  xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/ChatResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <StandardUICommand x:Key="CopyMessageCommand" Kind="Copy" ExecuteRequested="CopyMessage" />
      <XamlUICommand x:Key="NewChatCommand" ExecuteRequested="NewChat">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="N" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <XamlUICommand x:Key="SearchCommand" ExecuteRequested="FocusSearch">
        <XamlUICommand.KeyboardAccelerators>
          <KeyboardAccelerator Key="F" Modifiers="Control" />
        </XamlUICommand.KeyboardAccelerators>
      </XamlUICommand>
      <DataTemplate x:Key="IncomingMessage" x:DataType="local:MessageRow">
        <Grid Margin="{x:Bind Spacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="{x:Bind TimeGroup}"
            Visibility="{x:Bind HasTimeGroup}"
            Style="{StaticResource TimeGroupStyle}"
          />
          <Border
            Grid.Row="1"
            Style="{StaticResource BubbleStyle}"
            Margin="0,0,48,0"
            HorizontalAlignment="Left"
            CornerRadius="16,16,16,4"
            Background="{ThemeResource IncomingBubbleBackgroundBrush}"
            BorderBrush="{ThemeResource IncomingBubbleBorderBrush}"
            BorderThickness="1"
          >
            <Border.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem
                  Command="{StaticResource CopyMessageCommand}"
                  CommandParameter="{x:Bind Text}"
                />
              </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel>
              <TextBlock
                Text="{x:Bind Text}"
                Style="{StaticResource BubbleTextStyle}"
                Foreground="{ThemeResource IncomingBubbleForegroundBrush}"
              />
              <TextBlock
                ToolTipService.ToolTip="{x:Bind FullTime}"
                Text="{x:Bind Time}"
                Visibility="{x:Bind HasTime}"
                Style="{StaticResource BubbleTimeStyle}"
                Foreground="{ThemeResource IncomingBubbleCaptionBrush}"
              />
            </StackPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="OutgoingMessage" x:DataType="local:MessageRow">
        <Grid Margin="{x:Bind Spacing}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="{x:Bind TimeGroup}"
            Visibility="{x:Bind HasTimeGroup}"
            Style="{StaticResource TimeGroupStyle}"
          />
          <Grid
            Grid.Row="1"
            MaxWidth="560"
            Margin="48,0,0,0"
            HorizontalAlignment="Right"
          >
            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem
                  Command="{StaticResource CopyMessageCommand}"
                  CommandParameter="{x:Bind Text}"
                />
              </MenuFlyout>
            </Grid.ContextFlyout>
            <Border
              x:Name="MessageSurface"
              CornerRadius="16,16,4,16"
              Background="{ThemeResource OutgoingBubbleBackgroundBrush}"
              BorderBrush="{ThemeResource OutgoingBubbleBorderBrush}"
              BorderThickness="1"
            />
            <StackPanel Padding="16,12">
              <TextBlock
                x:Name="MessageText"
                Text="{x:Bind Text}"
                Style="{StaticResource BubbleTextStyle}"
                Foreground="{ThemeResource OutgoingBubbleForegroundBrush}"
              />
              <TextBlock
                x:Name="MessageTime"
                ToolTipService.ToolTip="{x:Bind FullTime}"
                Text="{x:Bind Time}"
                Visibility="{x:Bind HasTime}"
                Style="{StaticResource BubbleTimeStyle}"
                Foreground="{ThemeResource OutgoingBubbleCaptionBrush}"
              />
            </StackPanel>
          </Grid>
        </Grid>
      </DataTemplate>
      <local:MessageTemplateSelector
        x:Key="MessageTemplate"
        Incoming="{StaticResource IncomingMessage}"
        Outgoing="{StaticResource OutgoingMessage}"
      />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleHistoryShortcut" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusComposerShortcut" />
    </Grid.KeyboardAccelerators>
    <VisualStateManager.VisualStateGroups>
      <!-- The unnamed first state is the narrow one; a trigger belongs on the
           wide side only, since `MinWindowWidth="0"` is the implicit default. -->
      <VisualStateGroup>
        <VisualState x:Name="CompactTitle" />
        <VisualState x:Name="FullTitle">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="400" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ConversationTitle.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ComposerFocusStates">
        <VisualState x:Name="ComposerUnfocused" />
        <VisualState x:Name="ComposerFocused">
          <VisualState.Setters>
            <Setter
              Target="ComposerSurface.BorderBrush"
              Value="{ThemeResource TextControlBorderBrushFocused}"
            />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Overlay" />
            <Setter Target="Shell.IsPaneOpen" Value="False" />
            <Setter Target="ConversationPanel.Margin" Value="4,0,4,4" />
            <Setter Target="ComposerArea.Padding" Value="12,8,12,12" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="800" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Shell.DisplayMode" Value="Inline" />
            <Setter Target="Shell.IsPaneOpen" Value="True" />
            <Setter Target="Shell.PaneBackground" Value="Transparent" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <local:DesktopTitleBar
      x:Name="AppTitleBar"
      Title="{x:Bind local:Labels.AppName}"
      IsPaneToggleButtonVisible="True"
      PaneToggleRequested="TitleBarToggle"
    >
      <TitleBar.IconSource>
        <BitmapIconSource UriSource="ms-appx:///Assets/Arut.png" ShowAsMonochrome="False" />
      </TitleBar.IconSource>
      <TitleBar.Resources>
        <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
        <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
        <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">
          Stretch
        </HorizontalAlignment>
      </TitleBar.Resources>
      <TitleBar.Content>
        <TextBlock
          x:Name="ConversationTitle"
          Visibility="Collapsed"
          Text="{x:Bind ViewModel.Title, Mode=OneWay}"
          Style="{StaticResource CaptionTextBlockStyle}"
          IsHitTestVisible="False"
          TextWrapping="NoWrap"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          Margin="0,0,12,0"
        />
      </TitleBar.Content>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <local:ActionButton
            x:Name="SearchButton"
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource SearchCommand}"
            AutomationProperties.Name="{x:Bind local:Labels.Search}"
            ToolTipService.ToolTip="{x:Bind local:Labels.Search}"
          >
            <Grid Width="16" Height="16">
              <AnimatedIcon>
                <AnimatedIcon.Source>
                  <animated:AnimatedFindVisualSource />
                </AnimatedIcon.Source>
                <AnimatedIcon.FallbackIconSource>
                  <FontIconSource Glyph="&#xE721;" FontSize="16" />
                </AnimatedIcon.FallbackIconSource>
              </AnimatedIcon>
            </Grid>
          </local:ActionButton>
          <local:ActionButton
            x:Name="NewChatButton"
            Style="{StaticResource IconButtonStyle}"
            Command="{StaticResource NewChatCommand}"
            AutomationProperties.Name="{x:Bind local:Labels.NewConversation}"
            ToolTipService.ToolTip="{x:Bind local:Labels.NewConversationShortcut}"
          >
            <Grid Width="16" Height="16">
              <FontIcon Glyph="&#xE710;" FontSize="16" />
            </Grid>
          </local:ActionButton>
        </StackPanel>
      </TitleBar.RightHeader>
    </local:DesktopTitleBar>
    <SplitView
      x:Name="Shell"
      Grid.Row="1"
      OpenPaneLength="280"
      DisplayMode="Overlay"
      PaneBackground="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
    >
      <SplitView.Pane>
        <Grid x:Name="HistoryPane" Padding="12,16,12,12" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            x:Uid="label_conversations_uid_text"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Margin="12,0"
          />
          <AutoSuggestBox
            x:Name="Search"
            Grid.Row="1"
            Header="{x:Bind local:Labels.Search}"
            Text="{x:Bind ViewModel.Search, Mode=TwoWay}"
            PlaceholderText="{x:Bind local:Labels.Search}"
            QueryIcon="Find"
            AutomationProperties.Name="{x:Bind local:Labels.Search}"
          />
          <Grid Grid.Row="2">
            <ListView
              x:Name="History"
              AutomationProperties.Name="{x:Bind local:Labels.Conversations}"
              ItemsSource="{x:Bind ViewModel.Conversations}"
              SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
              IsItemClickEnabled="True"
              ItemClick="ChatActivated"
            >
              <ListView.ItemContainerTransitions>
                <TransitionCollection>
                  <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
              </ListView.ItemContainerTransitions>
              <ListView.ItemContainerStyle>
                <Style
                  TargetType="ListViewItem"
                  BasedOn="{StaticResource DefaultListViewItemStyle}"
                >
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="12,8" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConversationRow">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Width="32"
                      Height="32"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      VerticalAlignment="Center"
                    >
                      <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          Text="{x:Bind Title, Mode=OneWay}"
                          FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis"
                        />
                        <!-- Rust decides what is unread; the dot only draws it. -->
                        <Ellipse
                          Grid.Column="1"
                          Width="8"
                          Height="8"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind Unread, Mode=OneWay}"
                          Fill="{ThemeResource AccentFillColorDefaultBrush}"
                          AutomationProperties.Name="{x:Bind local:Labels.Unread}"
                        />
                      </Grid>
                      <TextBlock
                        Text="{x:Bind Preview, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
              Text="{x:Bind ViewModel.HistoryEmptyLabel, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.IsHistoryEmpty, Mode=OneWay}"
              TextWrapping="Wrap"
              Margin="12,16"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              IsHitTestVisible="False"
            />
          </Grid>
        </Grid>
      </SplitView.Pane>
      <Border
        x:Name="ConversationPanel"
        Margin="4,0,8,8"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
      >
        <Grid>
          <ListView
            x:Name="Transcript"
            x:Uid="label_transcript_uid_name"
            ItemsSource="{x:Bind ViewModel.Conversation.Messages, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource MessageTemplate}"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="16,0,16,0"
            Loaded="TranscriptLoaded"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          >
            <ListView.Resources>
              <!-- These are reading rows. Keyboard focus remains visible, but
                   pointer movement must not imply that a row is an action. -->
              <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.KeyboardAccelerators>
              <!-- The copy command's keyboard route: the focused row, copied. -->
              <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyFocusedMessage" />
            </ListView.KeyboardAccelerators>
            <ListView.Footer>
              <Border
                x:Name="TranscriptEndSpace"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw"
              />
            </ListView.Footer>
            <ListView.ItemContainerTransitions>
              <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="True" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
          <StackPanel
            x:Name="EmptyState"
            Visibility="{x:Bind ViewModel.Conversation.IsEmpty, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="360"
            Margin="24"
            IsHitTestVisible="False"
          >
            <Border
              Width="64"
              Height="64"
              CornerRadius="{ThemeResource OverlayCornerRadius}"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Margin="0,0,0,8"
            >
              <FontIcon
                Glyph="&#xE8F2;"
                FontSize="28"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
              />
            </Border>
            <TextBlock
              Text="{x:Bind local:Labels.EmptyTitle}"
              Style="{StaticResource TitleTextBlockStyle}"
              TextWrapping="Wrap"
              TextAlignment="Center"
            />
            <TextBlock
              Text="{x:Bind local:Labels.EmptyHint}"
              TextWrapping="Wrap"
              TextAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
          <!-- Elevate the layout container, leaving the button's own visual
               available to native states and visibility animation hit testing. -->
          <Grid
            x:Name="LatestArea"
            Translation="0,0,12"
            MaxWidth="880"
            Margin="24,0,24,8"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
          >
            <local:ActionButton
              x:Name="LatestSurface"
              Style="{StaticResource DefaultButtonStyle}"
              Width="36"
              Height="36"
              CornerRadius="18"
              HorizontalAlignment="Right"
              Visibility="Collapsed"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              Padding="0"
              Click="ScrollToLatest"
              ToolTipService.ToolTip="{x:Bind local:Labels.Latest}"
              AutomationProperties.Name="{x:Bind local:Labels.Latest}"
            >
              <Button.Resources>
                <ResourceDictionary>
                  <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
                    </ResourceDictionary>
                  </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
              </Button.Resources>
              <Button.Shadow>
                <ThemeShadow />
              </Button.Shadow>
              <Grid>
                <AnimatedIcon Width="16" Height="16">
                  <AnimatedIcon.Source>
                    <animated:AnimatedChevronDownSmallVisualSource />
                  </AnimatedIcon.Source>
                  <AnimatedIcon.FallbackIconSource>
                    <FontIconSource Glyph="&#xE74B;" FontSize="14" />
                  </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
              </Grid>
            </local:ActionButton>
          </Grid>
          <Grid
            x:Name="ComposerArea"
            VerticalAlignment="Bottom"
            Padding="24,8,24,20"
            SizeChanged="ComposerAreaSizeChanged"
          >
            <Grid MaxWidth="880" HorizontalAlignment="Stretch" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <InfoBar
                IsOpen="{x:Bind ViewModel.Conversation.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Conversation.Error, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
              />
              <Grid
                Grid.Row="1"
                x:Name="ComposerCard"
                Translation="0,0,16"
              >
                <Border
                  x:Name="ComposerSurface"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource TextControlBorderBrush}"
                  CornerRadius="27"
                  Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                >
                  <Border.Shadow>
                    <ThemeShadow />
                  </Border.Shadow>
                </Border>
                <TextBox
                  x:Name="Composer"
                  Margin="8,8,48,8"
                  Text="{x:Bind ViewModel.Conversation.Draft.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="{x:Bind local:Labels.Composer}"
                  AutomationProperties.Name="{x:Bind local:Labels.Composer}"
                  AutomationProperties.HelpText="{x:Bind local:Labels.ComposerHint}"
                  ToolTipService.ToolTip="{x:Bind local:Labels.ComposerHint}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  MinHeight="36"
                  VerticalAlignment="Bottom"
                  MaxHeight="164"
                  FontSize="14"
                  Padding="10,7"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewKeyDown="ComposerKeyDown"
                  UseSystemFocusVisuals="False"
                  GotFocus="ComposerFocusChanged"
                  LostFocus="ComposerFocusChanged"
                >
                  <TextBox.Resources>
                    <!-- Keep the native editor, caret, selection, scrolling and
                         IME. The surrounding composer owns all input chrome. -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                  <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="SendShortcut" />
                  </TextBox.KeyboardAccelerators>
                </TextBox>
                <Canvas
                  x:Name="SendCaptureLayer"
                  IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw"
                />
                <local:ActionButton
                  x:Name="SendButton"
                  Margin="8"
                  HorizontalAlignment="Right"
                  Width="36"
                  Height="36"
                  Padding="0"
                  CornerRadius="18"
                  VerticalAlignment="Bottom"
                  Style="{StaticResource AccentButtonStyle}"
                  Command="{x:Bind ViewModel.Conversation.SendCommand, Mode=OneWay}"
                  Click="SendClicked"
                  AutomationProperties.Name="{x:Bind local:Labels.Send}"
                  ToolTipService.ToolTip="{x:Bind local:Labels.Send}"
                >
                  <Grid>
                    <FontIcon
                      Glyph="&#xE724;"
                      FontSize="16"
                      Visibility="{x:Bind ViewModel.Conversation.IsIdle, Mode=OneWay}"
                    />
                    <ProgressRing
                      Width="16"
                      Height="16"
                      IsActive="{x:Bind ViewModel.Conversation.IsSending, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Conversation.IsSending, Mode=OneWay}"
                    />
                  </Grid>
                </local:ActionButton>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </SplitView>
  </Grid>
</UserControl>
