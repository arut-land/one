<UserControl
    x:Class="Arut.Surface.Windows.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Arut.Surface.Windows"
    Loaded="ViewLoaded"
    Unloaded="ViewUnloaded">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewChatAccelerator" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="TogglePaneAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator" />
    </UserControl.KeyboardAccelerators>
    <UserControl.Resources>
        <DataTemplate x:Key="AssistantMessageTemplate">
            <StackPanel
                MaxWidth="680"
                Margin="0,8,72,8"
                HorizontalAlignment="Left"
                Spacing="5">
                <TextBlock
                    Margin="4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Arut" />
                <Border
                    Padding="15,11"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4,16,16,16">
                    <TextBlock
                        FontSize="15"
                        IsTextSelectionEnabled="True"
                        LineHeight="22"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UserMessageTemplate">
            <StackPanel
                MaxWidth="680"
                Margin="72,8,0,8"
                HorizontalAlignment="Right"
                Spacing="5">
                <TextBlock
                    Margin="4,0"
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="You" />
                <Border
                    Padding="15,11"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="16,4,16,16">
                    <TextBlock
                        FontSize="15"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="22"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <local:MessageTemplateSelector
            x:Key="MessageTemplateSelector"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"
            UserTemplate="{StaticResource UserMessageTemplate}" />
    </UserControl.Resources>

    <NavigationView
        x:Name="Navigation"
        AlwaysShowHeader="False"
        AutomationProperties.Name="Chat navigation"
        CompactModeThresholdWidth="640"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="920"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="288"
        PaneDisplayMode="Auto"
        PaneTitle="Chats">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,8,0,12">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Arut" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Your conversations" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.PaneCustomContent>
            <Grid Padding="8,0,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="New chat"
                    Click="NewChat"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="New chat (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Row="1"
                    Margin="12,12,0,2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="RECENT" />

                <ListView
                    x:Name="History"
                    Grid.Row="2"
                    AutomationProperties.Name="Recent chats"
                    ItemsSource="{x:Bind Model.History, Mode=OneWay}"
                    SelectionChanged="SelectChat"
                    SelectedValue="{x:Bind Model.SelectedChatId, Mode=OneWay}"
                    SelectedValuePath="Id"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="8,7" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="&#xE8BD;" />
                                <TextBlock
                                    Grid.Column="1"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </NavigationView.PaneCustomContent>

        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Padding="24,17"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="ConversationTitle"
                        FontSize="20"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        Text="New conversation"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        x:Name="SendingStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Orientation="Horizontal"
                        Spacing="7"
                        Visibility="Collapsed">
                        <ProgressRing Width="12" Height="12" IsActive="True" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Arut is responding" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="New chat"
                    Click="NewChat"
                    ToolTipService.ToolTip="New chat (Ctrl+N)">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="Messages"
                    Padding="24,16,24,24"
                    AutomationProperties.Name="Conversation messages"
                    ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                    ItemsSource="{x:Bind Model.State.Messages, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="28">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8BD;" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="How can I help?" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Start a conversation with Arut. Your recent chats stay available in the navigation pane."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border
                x:Name="ErrorPresenter"
                Grid.Row="2"
                Margin="24,0,24,10"
                Padding="12,10"
                AutomationProperties.LiveSetting="Assertive"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <TextBlock
                        x:Name="ErrorText"
                        Grid.Column="1"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border
                Grid.Row="3"
                Margin="24,0,24,20"
                Padding="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="Composer"
                        MinHeight="44"
                        VerticalContentAlignment="Center"
                        AcceptsReturn="False"
                        AutomationProperties.Name="Message"
                        BorderThickness="0"
                        KeyDown="ComposerKeyDown"
                        PlaceholderText="Message Arut"
                        Text="{x:Bind Model.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        MinWidth="88"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Send message"
                        Click="Send"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Send message (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <SymbolIcon Symbol="Send" />
                            <TextBlock x:Name="SendLabel" Text="Send" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</UserControl>
