<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Arut.ico</ApplicationIcon>
    <NativeBindingsDirectory>$(MSBuildProjectDirectory)/../../bindings/generated/csharp/$(Configuration)/runtimes/$(RuntimeIdentifier)/native</NativeBindingsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Strings/<lang>/Resources.resw is generated by `mise run generate` from
         product/i18n/locales (ADR 0022). -->
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <!-- Supplies `global using Arut.Ffi`, so the generated types need no facade. -->
  <Import Project="../../bindings/dotnet/Exports.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <ProjectReference
      Include="../../bindings/generated/csharp/$(Configuration)/BoltFFI.CSharp.csproj"
    />
    <Content
      Update="Assets\Arut.ico;Assets\Arut.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="$(NativeBindingsDirectory)/*.dll"
      Link="%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Target Name="RequireRustBindings" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(NativeBindingsDirectory)/arut_ffi.dll')"
      Text="Rust bindings are missing. Run mise run build:windows for Debug or mise run publish:windows for Release."
    />
  </Target>
  <!-- The .NET publish pipeline does not collect WinUI's loose XBF/PRI outputs. -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Include="$(TargetDir)$(TargetName).pri"
        RelativePath="$(TargetName).pri"
        CopyToPublishDirectory="PreserveNewest"
      />
      <_WinUIXbf Include="$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish
        Include="@(_WinUIXbf)"
        RelativePath="%(_WinUIXbf.RecursiveDir)%(_WinUIXbf.Filename)%(_WinUIXbf.Extension)"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
