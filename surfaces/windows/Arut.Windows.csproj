<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Strings/<lang>/Resources.resw is generated by `mise run i18n` from
         product/i18n/locales (ADR 0022). -->
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <Import Project="../../bindings/dotnet/Exports.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <ProjectReference Include="../../bindings/dotnet/Arut.Bindings.csproj" />
  </ItemGroup>
</Project>
