{
  "name": "arut-vscode",
  "displayName": "arut",
  "icon": "media/arut.png",
  "description": "The arut VS Code surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE-FSL",
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arut.chat",
        "title": "Arut: Open Chat"
      }
    ]
  },
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@arut/bindings-typescript": "workspace:*",
    "@arut/chat-ui": "workspace:*",
    "@arut/runtime-browser": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxc-transform-react": "catalog:",
    "vite": "catalog:"
  }
}
