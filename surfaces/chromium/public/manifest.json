{
  "manifest_version": 3,
  "name": "arut",
  "version": "0.1.0",
  "icons": {
    "16": "icons/arut-16.png",
    "32": "icons/arut-32.png",
    "48": "icons/arut-48.png",
    "128": "icons/arut-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_icon": {
      "16": "icons/arut-16.png",
      "32": "icons/arut-32.png"
    },
    "default_popup": "index.html"
  }
}
