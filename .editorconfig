root = true

[*.{cs,csx,config,csproj,props,slnx,targets,xaml,xml,manifest}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.manifest]
csharpier_formatter = xml
