# The root .editorconfig requires LF everywhere and `dotnet format
# --verify-no-changes` enforces it on Windows, where Git's default autocrlf
# would otherwise check every text file out with CRLF and fail the gate.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.woff2 binary
*.gresource binary

# Repository prose is documentation, not implementation language.
*.md linguist-documentation

# Agent skills and their bundled references, scripts, and templates are support
# material sourced independently from the product.
.agents/skills/** linguist-vendored -linguist-documentation
.agents/upstream/** linguist-vendored -linguist-documentation
.agents/README.md linguist-documentation
surfaces/linux/data/icons/lucide/** linguist-vendored

